<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_music_school_exam" model="ir.actions.report">
        <field name="name">Exam</field>
        <field name="model">music.school.exam</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">music_school_gerard.report_music_school_exam</field>
        <field name="report_file">music_school_gerard.report_music_school_exam</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" ref="model_music_school_exam"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_music_school_exam">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="o.name"/>
                        <div class="row">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Course:</strong>
                                <span t-field="o.course_id.name"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Instrument:</strong>
                                <span t-field="o.instrument_id.name"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Examiner:</strong>
                                <span t-field="o.teacher_id.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Date:</strong>
                                <span t-field="o.date"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Min Score:</strong>
                                <span t-field="o.min_score_to_pass"/>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>Max Score:</strong>
                                <span t-field="o.max_score"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table table-borderless mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">Name</th>
                                    <th class="text-start">Score Obtained</th>
                                    <th class="text-start">Passed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.results_ids" t-as="result">
                                    <tr>
                                        <td><span t-field="result.student_id.name"/></td>
                                        <td><span t-field="result.score"/></td>
                                        <td><t t-out="'Yes' if result.passed else 'No'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
