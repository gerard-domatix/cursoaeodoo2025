<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="music_school_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">music.school.course</field>
        <field name="view_mode">kanban,list,pivot,calendar,graph,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create your first course
        </p>
        </field>
    </record>
    
    <record id="music_school_course_list" model="ir.ui.view">
        <field name="name">music.school.course.view.list</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <list multi_edit="1" string="Courses">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="instrument_id"/>
                <field name="state"/>
                <field name="level"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="capacity" optional="hide"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="music_school_course_view_form" model="ir.ui.view">
        <field name="name">music.school.course.view.form</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <button name="action_active" string="Activate Course" type="object" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_archived" string="Archive Course" type="object" invisible="state == 'archived'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_create_lesson" string="Create Lesson" type="object" class="btn-primary"/>
                    <button name="action_assign_students" string="Assign Students" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Course"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="teacher_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}" domain="[('level','=',level)]"/>
                            <field name="instrument_id"/>
                            <field name="state"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="date_start" optional="hide"/>
                            <field name="date_end" optional="hide"/>
                            <field name="capacity" optional="hide"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Students">
                            <field name="students_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="music_school_course_view_search" model="ir.ui.view">
        <field name="name">music.school.course.view.search</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name" filter_domain="['|',('name','ilike',self),('instrument_id','=',self)]"/>
                <field name="teacher_id"/>
                <field name="instrument_id"/>
                <field name="level"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                <filter name="group_by_teacher" string="Teacher" context="{'group_by': 'teacher_id'}"/>
                <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
            </search>
        </field>
    </record>

    <record id="music_school_course_view_kanban" model="ir.ui.view">
        <field name="name">music.school.course.view.kanban</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_group_by="state" class="o_kanban_small_column">
            <field name="name"/>
            <field name="teacher_id"/>
            <field name="instrument_id"/>
            <field name="date_start"/>
            <field name="level"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                       <field name="name" class="fw-bold fs-5"/>
                       <field name="instrument_id"/>
                       <field name="date_start"/>
                       <footer>
                            <div class="d-flex mt-auto align-items-center">
                                <field name="level" widget="priority" class="me-2"/>
                            </div>
                            <field name="teacher_id" widget="many2one_avatar_user" class="ms-auto"/>
                       </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="music_school_course_view_pivot" model="ir.ui.view">
        <field name="name">music.school.course.view.pivot</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <pivot string="Course">
                <field name="teacher_id" type="row"/>
                <field name="date_start" type="col"/>
                <field name="capacity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="music_school_course_view_graph" model="ir.ui.view">
        <field name="name">music.school.course.view.graph</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <graph string="Course" type="bar">
                <field name="teacher_id"/>
                <field name="capacity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="music_school_course_view_calendar" model="ir.ui.view">
        <field name="name">music.school.course.view.calendar</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <calendar string="Course" date_start="date_start" date_stop="date_end" color="teacher_id">
                <field name="name"/>
                <field name="level"/>
                <field name="teacher_id"/>
                <field name="capacity"/>
            </calendar>
        </field>
    </record>
</odoo>
