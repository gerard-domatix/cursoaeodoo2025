<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="music_school_lesson_action" model="ir.actions.act_window">
    <field name="name">Lessons</field>
    <field name="res_model">music.school.lesson</field>
    <field name="view_mode">kanban,list,pivot,calendar,graph,form</field>
    <field name="context">{}</field> 
    <field name="help" type="html">
    <p class="o_view_nocontent_smiling_face">
        Create your first lesson
    </p>
    </field>
</record>

<record id="music_school_lesson_list" model="ir.ui.view">
    <field name="name">music.school.lesson.view.list</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <list multi_edit="1" string="Lessons">
            <field name="teacher_id"/>
            <field name="course_id"/>
            <field name="classroom_id"/>
            <field name="date"/>
            <field name="duration"/>
            <field name="notes" optional="hide"/>
            <field name="state" optional="hide"/>
        </list>
    </field>
</record>

<record id="music_school_lesson_view_form" model="ir.ui.view">
    <field name="name">music.school.lesson.view.form</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <form string="Lesson">
            <header>
                <field name="state" widget="statusbar" statusbar_visible="scheduled, completed, canceled"/>
            </header>
            <sheet>
                <div class="oe_title">
                        <h1>
                            <field name="course_id" placeholder="Course"/>
                        </h1>
                </div>
                <group>
                    <group>
                        <field name="teacher_id"/> 
                        <field name="classroom_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="duration" widget="float_time"/>
                    </group>
                </group>
                <notebook>
                    <page name="notes" string="Notes">
                        <field name="notes"/>
                    </page>
                    <page name="attendances" string="Attendances">
                        <field name="attendance_ids" context="{'default_date': date, 'list_view_ref': 'music_school_gerard.music_school_lesson_attendance_simple_view_list'}"/>
                    </page>
                </notebook> 
            </sheet>     
        </form>
    </field>
</record>

<record id="music_school_lesson_view_search" model="ir.ui.view">
    <field name="name">music.school.lesson.view.search</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <search string="">
            <field name="teacher_id"/>
            <field name="course_id" filter_domain="['|',('course_id','ilike',self),('course_id.instrument_id.name','=',self)]"/>
            <field name="classroom_id"/>
            <field name="state"/>
            <field name="date"/>
            <filter name="group_by_classroom" string="Classroom" context="{'group_by': 'classroom_id'}" />
            <filter name="group_by_teacher" string="Teacher" context="{'group_by': 'teacher_id'}" />
            <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}" />
            <filter name="group_by_state" string="State" context="{'group_by': 'state'}" />
            <filter name="filter_yesterday" string="Ayer"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%%Y-%%m-%%d 00:00:00')),
                    ('date', '&lt;', context_today().strftime('%%Y-%%m-%%d 00:00:00'))]"/>

        </search>
    </field>
</record>

<record id="music_school_lesson_view_kanban" model="ir.ui.view">
    <field name="name">music.school.lesson.view.kanban</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <kanban highlight_color="color" default_group_by="state" class="o_kanban_small_column">
            <field name="teacher_id"/>
            <field name="course_id"/>
            <field name="classroom_id"/>
            <field name="date"/>
            <templates>
                <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="color" widget="kanban_color_picker"/>
                </t>
                <t t-name="card">
                        <field name="course_id" class="fw-bold fs-5"/>
                        <field name="classroom_id"/>
                        <field name="date" widget="datetime"/>
                        <footer>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-clock-o me-1"/> 
                                <field name="duration" widget="float_time"/>
                            </div>
                            <field name="teacher_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<record id="music_school_lesson_view_pivot" model="ir.ui.view">
    <field name="name">music.school.lesson.view.pivot</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <pivot string="Lesson">
            <field name="teacher_id" type="row"/>
            <field name="date" type="col"/>
            <field name="duration" type="measure"/>
        </pivot>
    </field>
</record>

<record id="music_school_lesson_view_graph" model="ir.ui.view">
    <field name="name">music.school.lesson.view.graph</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <graph string="Lesson" type="bar">
            <field name="teacher_id"/>
            <field name="duration" type="measure"/>
        </graph>
    </field>
</record>

<record id="music_school_lesson_view_calendar" model="ir.ui.view">
    <field name="name">music.school.lesson.view.calendar</field>
    <field name="model">music.school.lesson</field>
    <field name="arch" type="xml">
        <calendar string="Lesson Calendar" date_start="date" date_delay="duration" color="teacher_id">
            <field name="teacher_id"/>
            <field name="course_id"/>
            <field name="classroom_id"/>
            <field name="state"/>
        </calendar>
    </field>
</record>
</odoo>
